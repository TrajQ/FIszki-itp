# Warsztat jako usługa systemd (ETAP 251). instaluj_serwer.sh podstawia
# UZYTKOWNIK i KATALOG. Jeden proces z wątkami: SQLite i licznik prób
# logowania (logowanie.py) są wspólne dla wszystkich zapytań.
[Unit]
Description=Warsztat (Flask przez gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=UZYTKOWNIK
WorkingDirectory=KATALOG
ExecStart=KATALOG/.venv/bin/gunicorn --workers 1 --threads 4 --timeout 180 --bind 127.0.0.1:8000 wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
