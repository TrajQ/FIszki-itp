# Skopiuj do .env i uzupełnij lokalnie. .env NIE trafia do gita.

SECRET_KEY=zmien-mnie-na-losowy-string
FLASK_DEBUG=0
PORT=5000

# Klucze API modułów — uzupełniane w kolejnych ETAPach, gdy dany moduł
# faktycznie zacznie z nich korzystać.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
GUS_BDL_API_KEY=

# Kronika zmian (MPZP): usługa WMS z ortofotomapami archiwalnymi GUGiK.
# Zmień tylko, jeśli domyślny adres przestanie działać.
# ORTO_ARCHIWALNA_WMS=https://mapy.geoportal.gov.pl/wss/service/PZGIK/ORTO/WMS/StandardResolutionTime
